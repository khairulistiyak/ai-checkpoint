{
  "name": "ai-checkpoint",
  "version": "1.0.1",
  "description": "The Deterministic State Ledger & Execution Framework for AI Coding Agents",
  "desktopName": "ai-checkpoint.desktop",
  "bin": {
    "ai-checkpoint": "./scripts/ledger.cjs"
  },
  "main": "packages/core/index.js",
  "exports": {
    ".": "./packages/core/index.js",
    "./cli": "./packages/cli/index.js",
    "./core": "./packages/core/index.js"
  },
  "files": [
    "packages",
    "templates",
    "dashboard",
    "scripts"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "npm --prefix dashboard run dev",
    "build:engine": "node scripts/build-engine.js",
    "test": "bats tests",
    "doctor": "./l doctor",
    "validate": "./l v",
    "live": "node scripts/live-hud.cjs",
    "hud": "node scripts/live-hud.cjs",
    "electron:dev": "electron electron/main.js --no-sandbox",
    "electron:build": "bash scripts/build-desktop.sh",
    "electron:build:mac": "bash scripts/build-desktop.sh mac",
    "electron:build:win": "bash scripts/build-desktop.sh win",
    "electron:build:linux": "bash scripts/build-desktop.sh linux",
    "electron:build:all": "bash scripts/build-desktop.sh all",
    "release:check": "node scripts/release-check.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/khairulistiyak/ai-checkpoint.git"
  },
  "keywords": [
    "ai",
    "checkpoint",
    "coding-agent",
    "context-ledger",
    "deterministic",
    "cli",
    "llm",
    "developer-tools"
  ],
  "homepage": "https://github.com/khairulistiyak/ai-checkpoint#readme",
  "bugs": "https://github.com/khairulistiyak/ai-checkpoint/issues",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "bats": "^1.13.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "javascript-obfuscator": "^4.1.0"
  },
  "author": "Khairul Istiyak <khairulistiyak@gmail.com>",
  "license": "MIT"
}
